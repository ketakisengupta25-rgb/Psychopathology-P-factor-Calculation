*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# PyCharm / VS Code
.idea/
.vscode/

# Jupyter
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
